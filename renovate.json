{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^isponsorblocktv/config\\.yaml$/",
        "/^isponsorblocktv-setup/config\\.yaml$/"
      ],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "iSponsorBlockTV",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^globalping-probe/config\\.yaml$/"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "globalping/globalping-probe",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\S+=(?<currentValue>\\S+)"
      ]
    }
  ]
}
